# Archivo de ejemplo .env (NO subir al repositorio). Copia este archivo a `.env` y
# rellena los valores sensibles antes de ejecutar la aplicación en tu máquina.

# Clave secreta de Django (genera una nueva para tu entorno de desarrollo):
DJANGO_SECRET_KEY="pon_aqui_una_clave_muy_larga_y_segura"

# Otras variables útiles que podrías añadir:
# DEBUG=True
# DATABASE_URL=sqlite:///db.sqlite3
# EMAIL_HOST_USER=usuario@example.com
